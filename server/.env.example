# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/authenticator_db

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_string_min_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

BCRYPT_ROUNDS=12
